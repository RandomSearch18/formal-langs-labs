{
  "version": "2.0.0",
  "configurations": [
    {
      "name": "Debug ANTLR4 grammar",
      "type": "antlr-debug",
      "request": "launch",
      "input": "${fileDirname}/input.txt",
      "grammar": "${file}",
      "startRule": "aexp",
      "printParseTree": true,
      "visualParseTree": true
    }
  ]
}
